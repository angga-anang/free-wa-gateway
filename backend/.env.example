# ---- Server ----
PORT=3000
NODE_ENV=development
# Comma-separated origins allowed to call the API/dashboard from a browser
CORS_ORIGIN=http://localhost:8090

# ---- PostgreSQL ----
DATABASE_URL=postgres://freegw:freegw@localhost:5432/freegw_gateway

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Security ----
# 32-byte (64 hex char) key used for AES-256-GCM encryption of auth_secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=replace_with_64_char_hex_string_generated_locally_______________

# Bootstrap API key printed once on first run if api_configs table is empty.
# You can also generate/rotate keys via POST /api/v1/auth/keys once the
# bootstrap key has been used to authenticate.
BOOTSTRAP_API_KEY=

# ---- WhatsApp Engine ----
# Randomized humanized delay window (ms) between message sends, per device.
MIN_SEND_DELAY_MS=2000
MAX_SEND_DELAY_MS=5000
MAX_SEND_RETRIES=3

# How often (ms) the reconnect/keep-alive healer checks socket liveness
SOCKET_HEALTHCHECK_INTERVAL_MS=30000
